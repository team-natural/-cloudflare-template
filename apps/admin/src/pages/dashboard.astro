---
// ADM-01 (PRD-04 §3-2) — the admin landing route, and the reference for how an admin PAGE
// checks its session. API routes throw and let toErrorResponse() turn that into a 401
// (see pages/api/v1/auth/me.ts); a page has to redirect to the login screen instead, because
// a 401 body is not something a browser visitor can act on.
//
// There is no auth middleware by design (DEV-04 §2, src/middleware.ts) — every page and route
// checks at the top of its own handler. Copy this block into each new admin page.
//
// TEMPLATE SCAFFOLD: intentionally minimal. The real dashboard (KPI cards, charts, recent
// activity — PRD-04 §4-3-1) is built in step 3 of the docs/00_DEV_GUIDE.md §3 workflow with
// the admin-design skill. What must survive that rebuild is the session guard below.
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import LogoutButton from "../lib/components/logout-button.svelte";
import { createDb } from "$lib/server/db/client";
import { getSession } from "$lib/server/auth/session";
import { getAdminUserByPublicId, toPublicAdminUser } from "$lib/server/services/admin-users";

const db = createDb(env.DB);
const session = await getSession(Astro.cookies, db);
if (!session) return Astro.redirect("/", 302);

const row = await getAdminUserByPublicId(db, session.adminUserPublicId);
// The session row joins admin_users, so a missing user here means the row vanished between the
// two queries — treat it as logged out rather than rendering a page with no user.
if (!row) return Astro.redirect("/", 302);
const user = toPublicAdminUser(row);
---

<Layout title="ダッシュボード — apps/admin">
  <main class="mx-auto flex min-h-screen max-w-3xl flex-col gap-8 p-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="text-2xl font-semibold">ダッシュボード</h1>
      <LogoutButton client:load />
    </header>

    <section class="grid gap-2">
      <p class="text-sm">
        <span class="text-muted-foreground">ログイン中:</span>
        {user.name}（{user.email}）
      </p>
      <p class="text-sm">
        <span class="text-muted-foreground">ロール:</span>
        {user.role}
      </p>
    </section>

    <p class="text-sm text-muted-foreground">ADM-01 の骨組みのみ。KPI カード・グラフ・直近イベントは PRD-04 §4-3-1 に従って admin-design スキルで実装する（docs/00_DEV_GUIDE.md §3-3 ステップ 3）。</p>
  </main>
</Layout>
