# Local secrets for `astro dev` / `wrangler dev` — copy to `.dev.vars` and fill in.
# `.dev.vars` is gitignored; this .example file is the committed list of keys (DEV-08 §8).
#
# In staging/production these are Workers Secrets, NOT `vars`:
#   pnpm --filter admin exec wrangler secret put SESSION_SIGNING_KEY --env production
# Non-secret configuration (SESSION_TTL_DAYS, AUTH_LOCKOUT_*) lives in wrangler.jsonc `vars`
# instead — and must be repeated in every env block, because `vars` is not inheritable.

# --- Required ---
# Nothing here is required by the code that ships today: the auth backend reads only the
# wrangler.jsonc `vars` (SESSION_TTL_DAYS, AUTH_LOCKOUT_*). The keys below are the ones a project
# reaches for first; fill them in as the features that consume them land.

APP_NAME=
APP_URL=
APP_ENV=development

# --- Needed once invite / password-reset land (F-01-04, F-07-06 — not read by any code yet) ---
# HMAC key for invite and password-reset tokens (Web Crypto `crypto.subtle.sign` — DEV-02 §1-1).
# NOT used for session cookies: the session id is an unsigned 32-byte CSPRNG value validated by
# the admin_sessions lookup, so leaving this empty does not weaken login.
# Generate with: openssl rand -base64 32
SESSION_SIGNING_KEY=

# --- Mail (Resend — DEV-01 §1, DEV-10 §2). Required once inquiry notifications land (F-06-01/03).
RESEND_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# --- Adoption-gated: uncomment only if the project adopts the feature ---
# Lightweight EC (FG-05 — DEV-10 §3)
# STRIPE_KEY=
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# Error tracking (DEV-08 §9)
# SENTRY_DSN=

# AI features (PRD-05, DEV-01 §2). Model ids/prices: check the provider's official docs.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
