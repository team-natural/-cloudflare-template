{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "admin",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },

  // `vars` is a NON-INHERITABLE wrangler key: a named environment does not pick up this block,
  // so every value here must be repeated in each env.* below (same trap as `migrations_dir`).
  // Leaving one out makes the auth lockout fail open — see the Number.isFinite guards in
  // lib/server/auth/lockout.ts and session.ts.
  "vars": {
    "SESSION_TTL_DAYS": "30",
    // Auth lockout (DEV-02 §7): N failures within a minute lock the IP/account out for M minutes
    "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
    "AUTH_LOCKOUT_MINUTES": "15",
  },

  // Shared with apps/public — copy the same database_id / bucket_name that were
  // generated when creating them from apps/public/wrangler.jsonc (DEV-08 §1).
  //
  // D1 migrations live in packages/schema/migrations and are applied from this app only
  // (DEV-01 §1, DEV-07 §12). `migrations_dir` must be repeated in every env block —
  // wrangler does not inherit it from the top level.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-db-name",
      "database_id": "replace-with-database-id",
      "migrations_dir": "../../packages/schema/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "replace-with-bucket-name",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "replace-with-kv-namespace-id",
    },
  ],

  "env": {
    "staging": {
      "vars": {
        "APP_ENV": "staging",
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-staging",
          "database_id": "replace-with-database-id-staging",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-staging" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-staging" }],
    },
    "production": {
      "vars": {
        "APP_ENV": "production",
        "SESSION_TTL_DAYS": "30",
        "AUTH_LOCKOUT_MAX_ATTEMPTS": "5",
        "AUTH_LOCKOUT_MINUTES": "15",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "replace-with-db-name-production",
          "database_id": "replace-with-database-id-production",
          "migrations_dir": "../../packages/schema/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "replace-with-bucket-name-production" }],
      "kv_namespaces": [{ "binding": "KV", "id": "replace-with-kv-namespace-id-production" }],
    },
  },
}
