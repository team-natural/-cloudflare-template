const DEFAULT_PER_PAGE = 20;
const MAX_PER_PAGE = 100;

export async function list{{pascalCase name}}(db: DbClient, options: { afterId?: number | null; perPage?: number }) {
  const perPage = Math.min(options.perPage ?? DEFAULT_PER_PAGE, MAX_PER_PAGE);
  const rows = await db
    .select()
    .from({{table}})
    .where(options.afterId ? gt({{table}}.id, options.afterId) : undefined)
    .orderBy({{table}}.id)
    .limit(perPage + 1);

  const hasMore = rows.length > perPage;
  const page = rows.slice(0, perPage);
  return { items: page, nextId: hasMore ? page[page.length - 1].id : null };
}

export async function get{{pascalCase name}}By{{pascalCase externalKeyField}}(db: DbClient, {{camelCase externalKeyField}}: string) {
  const [row] = await db
    .select()
    .from({{table}})
    .where(eq({{table}}.{{camelCase externalKeyField}}, {{camelCase externalKeyField}}))
    .limit(1);
  if (!row) throw new NotFoundError();
  return row;
}

export async function create{{pascalCase name}}(db: DbClient, input: Create{{pascalCase name}}Input) {
  const now = new Date().toISOString();
  const [row] = await db
    .insert({{table}})
    .values({
{{#if hasAutoKey}}
      publicId: ulid(),
{{/if}}
{{#each fieldsList}}
      {{this}}: input.{{this}},
{{/each}}
{{#if hasTransitions}}
      {{statusField}}: "{{firstState}}",
{{/if}}
      updatedAt: now,
    })
    .returning();
  return row;
}

export async function update{{pascalCase name}}(db: DbClient, {{camelCase externalKeyField}}: string, input: Update{{pascalCase name}}Input) {
  const existing = await get{{pascalCase name}}By{{pascalCase externalKeyField}}(db, {{camelCase externalKeyField}});
  const [row] = await db
    .update({{table}})
    .set({ ...input, updatedAt: new Date().toISOString() })
    .where(eq({{table}}.id, existing.id))
    .returning();
  return row;
}

export async function delete{{pascalCase name}}(db: DbClient, {{camelCase externalKeyField}}: string): Promise<void> {
  const existing = await get{{pascalCase name}}By{{pascalCase externalKeyField}}(db, {{camelCase externalKeyField}});
  await db.delete({{table}}).where(eq({{table}}.id, existing.id));
}
{{#if hasTransitions}}

// Single transition function per DEV-01 §4「状態遷移の集約」— status is never updated by any
// other function in this file.
export async function transition{{pascalCase name}}(db: DbClient, {{camelCase externalKeyField}}: string, to: {{pascalCase name}}Status, session: Session) {
  const existing = await get{{pascalCase name}}By{{pascalCase externalKeyField}}(db, {{camelCase externalKeyField}});
  const from = existing.{{statusField}} as {{pascalCase name}}Status;

  if (!allowedTransitions(from).includes(to)) {
    throw new InvalidStateTransitionError("{{pascalCase name}}", from, to);
  }

  // Status update and audit log land in one transaction (DEV-05 §3, DEV-09 §3-3).
  const [updatedRows] = await db.batch([
    db
      .update({{table}})
      .set({ {{statusField}}: to, updatedAt: new Date().toISOString() })
      .where(eq({{table}}.id, existing.id))
      .returning(),
    activityLogInsert(db, {
      logName: "content",
      description: `{{pascalCase name}} ${from} -> ${to}`,
      subjectType: "{{pascalCase name}}",
      subjectId: existing.id,
      event: `{{camelCase name}}.${to}`,
      causerId: session.adminUserId,
      properties: { from, to },
    }),
  ]);

  return updatedRows[0];
}
