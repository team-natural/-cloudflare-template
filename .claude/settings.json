{
  "enabledMcpjsonServers": [
    "context7",
    "astro-docs",
    "svelte",
    "cloudflare-docs",
    "context-mode",
    "semble",
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Read(//workspace/**)",
      "mcp__context7",
      "mcp__astro-docs",
      "mcp__svelte",
      "mcp__cloudflare-docs",
      "mcp__playwright"
    ],
    "ask": [
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_network_request"
    ],
    "deny": [
      "Read(//workspace/**/.env)",
      "Read(//workspace/**/.env.*)",
      "Read(//workspace/**/.dev.vars)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-and-check.sh\"",
            "timeout": 120,
            "statusMessage": "Auto-formatting edited file (Prettier → ESLint → typecheck)..."
          }
        ]
      }
    ]
  }
}
